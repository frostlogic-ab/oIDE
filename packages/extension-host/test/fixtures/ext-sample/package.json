{
  "name": "@oide-test/sample",
  "version": "1.0.0",
  "type": "module",
  "oide": {
    "engine": "^1.0.0",
    "displayName": "Host test sample",
    "activation": ["onStartup"],
    "main": "dist/host.js",
    "contributes": {
      "commands": [
        { "id": "sample.echo", "title": "Echo" },
        { "id": "sample.crash", "title": "Crash" },
        { "id": "sample.lazy", "title": "Lazy" }
      ],
      "panels": [{ "id": "sample.panel", "title": "Panel", "entry": "dist/panel.html" }],
      "settings": { "sample.token": { "type": "string", "secret": true } }
    }
  }
}
