{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oIDE project extensions",
  "description": "Schema for <repo>/.oide/extensions.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema, for editors."
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "enabled": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
