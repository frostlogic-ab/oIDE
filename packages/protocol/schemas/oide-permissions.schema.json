{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oIDE project permissions",
  "description": "Schema for <repo>/.oide/permissions.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema, for editors."
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "allow": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ask": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deny": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
