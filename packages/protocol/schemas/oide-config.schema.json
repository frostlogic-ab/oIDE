{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oIDE project config",
  "description": "Schema for <repo>/.oide/config.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema, for editors."
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "defaultMode": {
      "type": "string",
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "auto",
        "bypassPermissions"
      ]
    },
    "presetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "setup": {
      "type": "string"
    }
  }
}
