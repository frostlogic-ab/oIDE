{
  "name": "@oide/desktop",
  "productName": "oIDE",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "description": "oIDE: Mission Control for many Claude Code CLI agents",
  "author": "oIDE contributors",
  "homepage": "https://github.com/frostlogic-ab/oIDE",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm run build:runtime && electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build && pnpm run build:runtime",
    "build:runtime": "vite build -c vite.runtime.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "electron-vite build && pnpm run build:runtime && playwright test",
    "dist": "electron-vite build && pnpm run build:runtime && pnpm run stage:language-servers && electron-builder --config electron-builder.yml --publish never",
    "stage:language-servers": "node ../../packages/language-servers/stage.mjs release/language-servers"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@parcel/watcher": "^2.6.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@oide/agent-core": "workspace:^",
    "@oide/extension-api": "workspace:^",
    "@oide/extension-host": "workspace:^",
    "@oide/git": "workspace:^",
    "@oide/language-servers": "workspace:^",
    "@oide/mcp-server": "workspace:^",
    "@oide/protocol": "workspace:^",
    "@oide/store": "workspace:^",
    "@oide/ui": "workspace:^",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/browser": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.28",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.5.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.80.0",
    "marked": "^18.3.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.8.1",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
